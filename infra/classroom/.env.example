# Restore JWT_APP_SECRET securely from the protected backup; it must match the backend.
# Generate fresh, different internal passwords for JICOFO_AUTH_PASSWORD and JVB_AUTH_PASSWORD.
CONFIG=/opt/lessonara-classroom/config
HTTP_PORT=8000
HTTPS_PORT=8443
TZ=America/Sao_Paulo
JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=
PUBLIC_URL=https://meet.example.com
ENABLE_HTTP_REDIRECT=0
JVB_ADVERTISE_IPS=203.0.113.10
ENABLE_AUTH=1
AUTH_TYPE=jwt
ENABLE_GUESTS=0
JWT_ALLOW_EMPTY=0
JWT_APP_ID=lessonara-poc
JWT_APP_SECRET=
JWT_ACCEPTED_ISSUERS=lessonara-poc
JWT_ACCEPTED_AUDIENCES=jitsi
XMPP_MUC_MODULES=token_affiliation
ENABLE_AUTO_OWNER=0
JICOFO_ENABLE_AUTH=0
ENABLE_RECORDING=0
ENABLE_TRANSCRIPTIONS=0
ENABLE_PREJOIN_PAGE=1
DISABLE_HTTPS=1
ENABLE_LETSENCRYPT=0
VIDEOBRIDGE_MAX_MEMORY=2048m
JICOFO_MAX_MEMORY=512m
JITSI_IMAGE_VERSION=stable-11248
JVB_ADVERTISE_PRIVATE_CANDIDATES=false
JVB_DISABLE_STUN=1
DISABLE_AWS_HARVESTER=true
ENABLE_P2P=0
ENABLE_WHITEBOARD=0
ENABLE_XMPP_WEBSOCKET=1
PROSODY_ENABLE_RATE_LIMITS=1
ENABLE_WELCOME_PAGE=0
ENABLE_CLOSE_PAGE=0
JVB_PORT=10000
