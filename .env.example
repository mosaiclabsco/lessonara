NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Apenas no servidor; nunca usar prefixo NEXT_PUBLIC_ nestas chaves.
SUPABASE_SECRET_KEY=sb_secret_...
RESEND_API_KEY=re_...
EMAIL_FROM=Lessonara <lessonara-noreply@mosaic-labs.co>
EMAIL_REPLY_TO=lessonara@mosaic-labs.co
# Raiz anterior: somente para migração planejada de um ambiente legado.
EMAIL_ENCRYPTION_KEY=
CRON_SECRET=
APP_URL=https://lessonara.mosaic-labs.co

GOOGLE_CLIENT_ID=

GOOGLE_CLIENT_SECRET=

# Sala online própria: somente no backend. Mesmo emissor/chave configurados no Prosody.
JITSI_URL=https://meet.mosaic-labs.co
JITSI_APP_ID=
JITSI_APP_SECRET=

# Novos ambientes: gerar a própria raiz v3. Migrar dados antigos antes de recusar formatos anteriores.
SEAL_WRITE_VERSION=v3

# CAPTCHA de login. Ativar no provedor somente após validar o widget web e desktop.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Rotação v3: publicar leitores primeiro; migrar dados antes de recusar os formatos anteriores.
# Gerar uma raiz própria com: openssl rand -hex 32
EMAIL_ENCRYPTION_KEY_NEXT=
EMAIL_ACCEPT_PREVIOUS_ENVELOPES=false

# Resend webhook signing secret (backend only)
RESEND_WEBHOOK_SECRET=
