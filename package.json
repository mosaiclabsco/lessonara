    "libphonenumber-js": "^1.13.15",
    "next": "16.4.1",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.32.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "jsqr": "1.4.0",
    "postcss": "^8.5.29",
    "prettier": "3.9.10",
